      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst binaryData = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst base64 = binaryData.toString('base64');\n\nconst safeName = ($('Code').item.json.name || 'lead')\n  .replace(/[^a-z0-9-]/gi, '-')\n  .replace(/-+/g, '-')\n  .replace(/^-|-$/g, '')\n  .toLowerCase();\n\nconst fileName = `${safeName || 'lead'}-voice-message.mp3`;\n\nconst response = await this.helpers.httpRequest({\n  method: 'POST',\n  url: 'https://api.cloudinary.com/v1_1/dlkroua3x/video/upload',\n  body: {\n    file: `data:audio/mpeg;base64,${base64}`,\n    upload_preset: 'x9qwgnpj',\n    filename_override: fileName\n  },\n  json: true,\n  ignoreHttpStatusErrors: true\n});\n\nif (!response.secure_url) {\n  throw new Error(`Cloudinary upload failed: ${JSON.stringify(response)}`);\n}\n\nitems[0].json.cloudinaryUrl = response.secure_url;\nitems[0].json.cloudinaryResponse = response;\n\nreturn items;"
      },
