        "jsCode": "const fields = $input.first().json.body.data.fields;\n\nconst name = fields.find(f => f.type === 'INPUT_TEXT' && f.label === 'Your Name')?.value;\nconst phone = fields.find(f => f.type === 'INPUT_PHONE_NUMBER')?.value;\nconst property = fields.find(f => f.type === 'INPUT_TEXT' && f.label !== 'Your Name')?.value;\n\nreturn [{\n  json: { name, phone, property }\n}];"
